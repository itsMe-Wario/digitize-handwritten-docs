# ──────────────────────────────────────────────
# Machine Shop Digitizer — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ──────────────────────────────────────────────

# MongoDB connection string
# Get yours from https://cloud.mongodb.com (free tier available)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/machine_shop?retryWrites=true&w=majority

# Google Gemini API key (primary AI provider)
# Get yours from https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API key (fallback AI provider)
# Get yours from https://console.mistral.ai (free tier available)
MISTRAL_API_KEY=your_mistral_api_key_here